{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nkanf-dev/OpenAllay-Extensions/main/schema/package-manifest.schema.json",
  "title": "OpenAllay Extension Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "provider",
    "summary",
    "loaders",
    "minecraftVersionRange",
    "openAllayApiVersionRange",
    "modIds",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "loaders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fabric",
          "neoforge"
        ]
      }
    },
    "minecraftVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "openAllayApiVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "modIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
